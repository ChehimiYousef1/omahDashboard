# =============================================================================
# OMAH Dashboard — Environment Template
# =============================================================================
#
# Copy this file to .env for local development.
#
# Never commit real credentials.
# Production credentials must be supplied through the production secret /
# environment configuration rather than committed files.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string.
MONGODB_URI=

# true permits the legacy/local fallback where supported.
# Production should normally use MongoDB.
DISABLE_MONGO=false

# Generate a strong independent value for every production environment.
JWT_SECRET=

# Allowed frontend origin(s), according to application CORS configuration.
ALLOWED_ORIGINS=http://localhost:5173

# Public signup remains disabled unless explicitly enabled.
ALLOW_SIGNUP=false


# -----------------------------------------------------------------------------
# Applicant Form / ingestion
# -----------------------------------------------------------------------------

APPLICANT_FORM_SOURCE_KEY=
APPLICANT_FORM_WEBHOOK_SECRET=
APPLICANT_SHEET_CSV_URL=

APPLICANT_AUTO_SYNC_ENABLED=false
APPLICANT_SYNC_WRITE_ENABLED=false


# -----------------------------------------------------------------------------
# Google OAuth / Calendar / Drive
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_WRITE_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SEND_UPDATES=none

GOOGLE_DRIVE_DOCUMENT_IMPORT_ENABLED=false


# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=


# -----------------------------------------------------------------------------
# Applicant interview notifications
# -----------------------------------------------------------------------------

INTERVIEW_EMAIL_ENABLED=false
INTERVIEW_NOTIFICATION_COMPANY_EMAIL=
INTERVIEW_NOTIFICATION_COMPANY_NAME=OMAH Recruitment
INTERVIEW_EMAIL_FROM=
INTERVIEW_EMAIL_FROM_NAME=OMAH Recruitment


# -----------------------------------------------------------------------------
# Communications
# -----------------------------------------------------------------------------

COMPANY_WHATSAPP_NUMBER=



# -----------------------------------------------------------------------------
# Applicant document storage
# -----------------------------------------------------------------------------
#
# Production must explicitly choose a provider. Prefer `s3` in AWS.
# Do not place AWS access keys in this file; production should use an IAM role.
#
DOCUMENT_STORAGE_PROVIDER=
DOCUMENT_LOCAL_STORAGE_DIR=
DOCUMENT_S3_BUCKET=
AWS_REGION=
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_FORCE_PATH_STYLE=false


# -----------------------------------------------------------------------------
# Production support surfaces
# -----------------------------------------------------------------------------
#
# Development exposes these tools normally.
# Production keeps them disabled unless explicitly enabled.
#

SWAGGER_ENABLED=false
DEV_API_ENABLED=false


# -----------------------------------------------------------------------------
# Test / diagnostics
# -----------------------------------------------------------------------------

TEST_APPLICANT_EMAIL=

# ------------------------------------------------------------
# P10 production integration configuration
# Keep write-capable providers disabled until staging verifies
# the production account, credentials and recipient behavior.
# ------------------------------------------------------------
APPLICANT_EMAIL_FROM=
APPLICANT_EMAIL_FROM_NAME=
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
